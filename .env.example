# Path to the SQLite database file (default: ./data/app.db)
DATABASE_PATH=

# Directory for uploaded files / receipts (default: ./data/uploads)
UPLOADS_PATH=

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public URL of the app (e.g. https://intern.example.at)
BETTER_AUTH_URL=http://localhost:3000
